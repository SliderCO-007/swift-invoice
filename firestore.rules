rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    function getUserData(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }
    function userExists(userId) {
      return exists(/databases/$(database)/documents/users/$(userId));
    }
    function getOrgData(orgId) {
      return get(/databases/$(database)/documents/organizations/$(orgId)).data;
    }
    function isOrgMember(orgId) {
      return request.auth != null && (
        request.auth.uid == orgId ||
        (exists(/databases/$(database)/documents/organizations/$(orgId)) &&
         request.auth.uid in getOrgData(orgId).members)
      );
    }
    function isOrgOwner(orgId) {
      return request.auth != null && request.auth.uid == orgId;
    }
    
    // --- Collections ---
    match /users/{userId} {
      allow read: if isOwner(userId) || (request.auth != null && userExists(request.auth.uid) && getUserData(request.auth.uid).get('orgId', '') == resource.data.get('orgId', ''));
      
      allow create: if isOwner(userId) && (
        request.resource.data.invoiceCount == 0 &&
        request.resource.data.subscriptionStatus == 'free' &&
        request.resource.data.uid == userId
      );
      
      allow update: if isOwner(userId) || (request.auth != null && resource.data.orgId == request.auth.uid);
      
      // A user's organization owns these customers and items.
      match /customers/{customerId} {
        allow read, write, create, delete: if isOrgMember(userId);
      }
      match /items/{itemId} {
        allow read, write, create, delete: if isOrgMember(userId);
      }
    }
    
    match /invoices/{invoiceId} {
      // An invoice can be read by any member of the organization, but updated/deleted only by the owner.
      allow read: if request.auth != null && isOrgMember(resource.data.orgId);
      allow update, delete: if isOrgOwner(resource.data.orgId);
        
      // An invoice can be created only by the organization owner if they meet plan limits.
      allow create: if isOrgOwner(request.resource.data.orgId) && (
          !userExists(request.auth.uid) ||
          getUserData(request.auth.uid).subscriptionStatus == 'active' ||
          (getUserData(request.auth.uid).get('subscriptionStatus', 'free') == 'free' && getUserData(request.auth.uid).get('invoiceCount', 0) < 5)
      );
    }
    
    match /userSettings/{userId} {
        // Any organization member can read the settings, but only the owner can modify.
        allow read: if isOrgMember(userId);
        allow create, update: if isOrgOwner(userId);
    }

    match /projects/{projectId} {
      // Any organization member can read the project, but only the owner can update/delete it.
      allow read: if request.auth != null && isOrgMember(resource.data.orgId);
      allow update, delete: if isOrgOwner(resource.data.orgId);
      
      // Only organization owners can create a project.
      allow create: if request.auth != null && isOrgOwner(request.resource.data.orgId);

      // Entries subcollection — any organization member may access/create entries.
      match /entries/{entryId} {
        allow read, write, create, delete: if request.auth != null &&
          isOrgMember(get(/databases/$(database)/documents/projects/$(projectId)).data.orgId);
      }
    }

    match /organizations/{orgId} {
      allow read: if isOrgMember(orgId);
      allow create, update, delete: if isOrgOwner(orgId);
    }

    match /invitations/{invitationId} {
      allow read: if request.auth != null && (
        request.auth.token.email == resource.data.email || 
        isOrgOwner(resource.data.orgId)
      );
      allow create: if request.auth != null && isOrgOwner(request.resource.data.orgId);
      allow update: if request.auth != null && (
        isOrgOwner(resource.data.orgId) ||
        (request.resource.data.status == 'accepted' && request.resource.data.acceptedBy == request.auth.uid)
      );
      allow delete: if request.auth != null && isOrgOwner(resource.data.orgId);
    }
  }
}