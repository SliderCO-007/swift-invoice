rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /invoices/{invoiceId} {
      // Allow users to create, read, update, and delete their own invoices
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
      // Allow users to create invoices
      allow create: if request.auth != null;
    }
    match /userSettings/{userId} {
      // Allow users to read, write, and create their own settings
      allow read, write, create: if request.auth != null && request.auth.uid == userId;
    }
    match /users/{userId} {
      // Allow users to manage their own document and subcollections
      allow read, write, create: if request.auth != null && request.auth.uid == userId;

      match /customers/{customerId} {
        // Allow users to manage their own customers
        allow read, write, create, delete: if request.auth != null && request.auth.uid == userId;
      }

      match /items/{itemId} {
        // Allow users to manage their own items
        allow read, write, create, delete: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}