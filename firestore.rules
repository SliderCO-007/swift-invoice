rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    // Checks if the requesting user is the owner of the document.
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    // Retrieves the user's profile document data from the 'users' collection.
    function getUserData(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }
    
    // --- Collections ---
    match /users/{userId} {
      // Users can READ their own profile.
      allow read: if isOwner(userId);
        
      // Users can CREATE their own profile during signup.
      // This enforces that the profile starts with the free plan and zero invoices.
      allow create: if isOwner(userId)
                    && request.resource.data.plan == 'free'
                    && request.resource.data.invoiceCount == 0;
      
      // Users can UPDATE their own profile but with strict conditions.
      allow update: if isOwner(userId) && (
                      // Case 1: An invoice is being created or deleted (transactional update).
                      // The invoiceCount must only change by +1 or -1, and no other fields can be changed.
                      (
                        (request.resource.data.invoiceCount == resource.data.invoiceCount + 1 ||
                         request.resource.data.invoiceCount == resource.data.invoiceCount - 1) &&
                         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['invoiceCount'])
                      )
                      ||
                      // Case 2: A user is updating general info (e.g., from Google Sign-In).
                      // This rule ensures the plan and invoiceCount are NOT changed during this type of update.
                      (
                        request.resource.data.plan == resource.data.plan &&
                        request.resource.data.invoiceCount == resource.data.invoiceCount
                      )
                  );
      
      // Subcollections: A user owns their own customers and items.
      match /customers/{customerId} {
        allow read, write, create, delete: if isOwner(userId);
      }
      match /items/{itemId} {
        allow read, write, create, delete: if isOwner(userId);
      }
    }
    
    match /invoices/{invoiceId} {
      // READ, UPDATE, DELETE: Only the user who owns the invoice can perform these actions.
      // It checks the `userId` field on the *existing* document in the database.
      allow read, update, delete: if isOwner(resource.data.userId);
        
      // CREATE: A user can create an invoice only if they meet the plan limits.
      allow create: if isOwner(request.resource.data.userId) && (
                      // Allow if the user's plan is NOT 'free' (i.e., they are a paid customer).
                      getUserData(request.auth.uid).plan != 'free'
                      ||
                      // OR, allow if the user's plan IS 'free' AND they have less than 2 invoices.
                      // This check uses the invoiceCount from the database BEFORE the transaction starts.
                      (getUserData(request.auth.uid).plan == 'free' && getUserData(request.auth.uid).invoiceCount < 2)
                    );
    }
    
    match /userSettings/{userId} {
      // Allow users to manage their own settings document.
      allow read, write, create: if isOwner(userId);
    }
  }
}