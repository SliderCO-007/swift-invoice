rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    function getUserData(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }
    function userExists(userId) {
      return exists(/databases/$(database)/documents/users/$(userId));
    }
    
    // --- Collections ---
    match /users/{userId} {
      allow read: if isOwner(userId);
      
      allow create: if isOwner(userId) && (
        request.resource.data.invoiceCount == 1 &&
        request.resource.data.subscriptionStatus == 'free' &&
        request.resource.data.uid == userId
      );
      
      // Allow users to update their own document.
      // The invoice creation and deletion logic is handled in the client-side transaction,
      // and the primary security concern is ensuring users can only modify their own data.
      allow update: if isOwner(userId);
      
      // A user owns their own customers and items.
      match /customers/{customerId} {
        allow read, write, create, delete: if isOwner(userId);
      }
      match /items/{itemId} {
        allow read, write, create, delete: if isOwner(userId);
      }
    }
    
    match /invoices/{invoiceId} {
      // An invoice can be read, updated, or deleted only by its owner.
      allow read, update, delete: if isOwner(resource.data.userId);
        
      // An invoice can be created only if the user meets the plan limits.
      allow create: if isOwner(request.resource.data.userId) && (
          // Allow if the user document does not exist yet (it's their first invoice)
          !userExists(request.auth.uid) ||
          // OR, allow creation if the user has an active subscription.
          getUserData(request.auth.uid).subscriptionStatus == 'active' ||
          // OR, allow if the user is on the free plan and has created less than 2 invoices.
          (getUserData(request.auth.uid).get('subscriptionStatus', 'free') == 'free' && getUserData(request.auth.uid).get('invoiceCount', 0) < 2)
      );
    }
    
    match /userSettings/{userId} {
        // The user must be the owner of the settings.
        allow read, create, update: if isOwner(userId);
    }
  }
}